# Copy these into your environment (or your process manager) before running.
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
USER_USERNAME=user
USER_PASSWORD=change-this-user-password
DEVICE_KEY=change-this-device-key

# SMS: "console" only prints messages (testing); "phone-gateway" sends real SMS.
SMS_PROVIDER=console
# Set SMS_PROVIDER=phone-gateway and configure the gateway connection:
PHONE_GATEWAY_URL=http://PHONE_IP:PORT/send-sms
PHONE_GATEWAY_USER=ExampleUser
PHONE_GATEWAY_PASSWORD=ExamplePassword
# Optional: route all gateway messages to this number while testing, not to parents.
# PHONE_GATEWAY_TEST_RECIPIENT=+639XXXXXXXXX

# Optional: where the SQLite file lives
# DB_FILE=/var/lib/rfid-attendance/data.db
